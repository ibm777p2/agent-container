# Copy to .env and fill in. Any variable left unset or blank falls back to its code default
# (see src/property_intelligence_rag/config.py).

# --- Required ---------------------------------------------------------------
# OpenRouter key for chat + embeddings: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Models (OpenRouter ids) ------------------------------------------------
# Defaults when blank: anthropic/claude-opus-5.5 and openai/text-embedding-3-small.
# The chat model must support tool calling. Free options (rate-limited, may change):
#   qwen/qwen3.8-27b:free
#   google/gemma-4-31b-it:free
#   nvidia/nemotron-3-super-120b-a12b:free
#   openrouter/free            (OpenRouter picks an available free model)
PI_CHAT_MODEL=qwen/qwen3.8-27b:free
# Free embedding options: nvidia/nemotron-3-embed-1b:free, liquid/lfm-2.5-embedding-350m:free
# Re-run `pi-ingest` after changing this; stored vectors are model-specific.
PI_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# PI_RETRIEVER_K=6

# --- Live property data (optional) ------------------------------------------
# Apify token for live Zillow data. Without it only fictional samples resolve.
APIFY_TOKEN=
# PI_ZILLOW_ACTOR=igolaizola/zillow-scraper-ppe
# PI_APIFY_ACTOR=maxcopell~zillow-detail-scraper
# PI_LOOKUPS_PER_HOUR=30
# PI_PROPERTY_CACHE_PATH=data/property-cache.sqlite3
# PI_PROPERTY_CACHE_TTL_SECONDS=86400
# PI_APIFY_TIMEOUT_SECONDS=120
PI_DEMO_FALLBACK=false

# --- Auth (optional locally, set both when deployed) -----------------------
# Bearer token callers send to /agent, /chat and /tools/property. Generate: openssl rand -hex 32
PI_AGENT_TOKEN=
# Optional second secret; when set, /agent also requires an `x-pi-secret` header.
PI_API_SECRET=
# Browser origins allowed by CORS besides localhost, comma-separated.
# PI_WEB_ORIGINS=https://your-frontend.example.com
